{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"collections": [
		{ "name": "skadi", "path": "./skadi" },
		{ "name": "actor", "path": "../sleipnir/actor" },
		{ "name": "hugi", "path": "../hugi/hugi" },
		{ "name": "runa", "path": "../runa" }
	],
	"enable_format": true,
	"enable_hover": true,
	"enable_snippets": true,
	"enable_checker_only_saved": true,
	"checker_args": "-vet -strict-style -disallow-do -warnings-as-errors"
}
