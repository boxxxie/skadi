			with = proc(__temple_w: __temple_io.Writer, this: T) -> (__temple_n: int, __temple_err: __temple_io.Error) {
				__temple_n += __temple_io.write_string(__temple_w, "[Root README](../README.md) · **Suite Renders** · [Detailed 1v1 & PyArrow Report](RESULTS.md)\n\n# Skadi Benchmarks & Visual Renders\n\nPure-Odin SIMD Arrow compute, compressed encodings (`Umbra_Array`, `RLE_Array`, `Dict_Array`), Sleipnir actor pipeline, and zero-copy `mmap`/`writev` IPC benchmark suite for **Skadi** (`") or_return /* 1:1 in template */
				__temple_n += __temple.__temple_write_int(__temple_w, int(this.total_benchmarks)) or_return /* 5:187 in template */
				__temple_n += __temple_io.write_string(__temple_w, "` Odin benchmarks across `") or_return /* 5:220 in template */
				__temple_n += __temple.__temple_write_int(__temple_w, int(this.group_count)) or_return /* 5:246 in template */
				__temple_n += __temple_io.write_string(__temple_w, "` groups, `") or_return /* 5:274 in template */
				__temple_n += __temple_io.write_string(__temple_w, this.total_samples_str) or_return /* 5:285 in template */
				__temple_n += __temple_io.write_string(__temple_w, "` samples in [`history.hugidb`](history.hugidb), paired with `") or_return /* 5:319 in template */
				__temple_n += __temple.__temple_write_int(__temple_w, int(this.cpp_count)) or_return /* 5:381 in template */
				__temple_n += __temple_io.write_string(__temple_w, "` Arrow C++ baselines at `") or_return /* 5:407 in template */
				__temple_n += __temple_io.write_string(__temple_w, this.cpp_commit) or_return /* 5:433 in template */
				__temple_n += __temple_io.write_string(__temple_w, "`), with visual SVG charts rendered via [`temple`](https://github.com/boxxxie/temple) under [`renders/`](renders/).\n\n---\n\n## Visual Renders (`-o:speed`)\n\n### 1. Skadi (Odin) vs Arrow C++: Builders & Compute Kernels\n\n![Skadi Odin vs Arrow C++ Builders and Compute Kernels](renders/odin_vs_cpp_compute.svg)\n\n### 2. Skadi (Odin) vs Arrow C++: Fusion, Strings, Encodings & Zero-Copy IPC\n\n![Skadi Odin vs Arrow C++ Fusion, Strings, Encodings and IPC](renders/odin_vs_cpp_fusion_strings_ipc.svg)\n\n### 3. Multi-Threaded & Sleipnir Actor Pipeline Speedups\n\n![Multi-Threaded and Sleipnir Actor Pipeline Speedups](renders/actor_and_mt_speedups.svg)\n\n---\n\n## Reproducing & Regenerating Renders\n\n```bash\n# 1. Run the 1v1 Odin vs Arrow C++ statistical suite (requires PyArrow / Arrow C++)\nmake bench-1v1\n\n# 2. Or run Odin benchmarks directly via hugi and append to benchmarks/history.hugidb\nhugi run benchmarks/odin --runs 5 --warmup 1\n\n# 3. Statistically compare the last two commits (Mann-Whitney U / Welch t-test)\nhugi compare --last --db benchmarks/history.hugidb\n\n# 4. Run 3-way Skadi / PyArrow / Arrow C++ comparison\nbash benchmarks/compare.sh\n\n# 5. Regenerate SVG charts in benchmarks/renders/ and tables below using temple AOT templates\nodin run benchmarks/render -collection:temple=../temple\n```\n\n---\n\n## Full Odin Benchmark Results (`") or_return /* 5:460 in template */
				__temple_n += __temple.__temple_write_int(__temple_w, int(this.total_benchmarks)) or_return /* 46:34 in template */
				__temple_n += __temple_io.write_string(__temple_w, "` Benchmarks)\n\n<!-- BEGIN_BENCHMARK_TABLE -->") or_return /* 46:67 in template */
				for group in this.groups { /* 49:1 in template */
					__temple_n += __temple_io.write_string(__temple_w, "\n### ") or_return /* 49:32 in template */
					__temple_n += __temple_io.write_string(__temple_w, group.title) or_return /* 50:5 in template */
					__temple_n += __temple_io.write_string(__temple_w, " (`") or_return /* 50:28 in template */
					__temple_n += __temple.__temple_write_int(__temple_w, int(group.count)) or_return /* 50:31 in template */
					__temple_n += __temple_io.write_string(__temple_w, "` benchmarks)") or_return /* 50:54 in template */
					if group.has_desc { /* 52:1 in template */
						__temple_n += __temple_io.write_string(__temple_w, "\n\n") or_return /* 52:25 in template */
						__temple_n += __temple_io.write_string(__temple_w, group.desc) or_return /* 54:1 in template */
					}
					__temple_n += __temple_io.write_string(__temple_w, "\n\n| Benchmark | Median (`p50`) | `P95` | Throughput / Ops | `CV%` | vs Arrow C++ | Allocs / op |\n| :--- | ---: | ---: | ---: | ---: | ---: | ---: |") or_return /* 55:11 in template */
					for row in group.rows { /* 59:1 in template */
						__temple_n += __temple_io.write_string(__temple_w, "\n| `") or_return /* 59:29 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.name) or_return /* 60:4 in template */
						__temple_n += __temple_io.write_string(__temple_w, "` | **") or_return /* 60:24 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.median) or_return /* 60:30 in template */
						__temple_n += __temple_io.write_string(__temple_w, "** | ") or_return /* 60:52 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.p95) or_return /* 60:57 in template */
						__temple_n += __temple_io.write_string(__temple_w, " | ") or_return /* 60:76 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.ops) or_return /* 60:79 in template */
						__temple_n += __temple_io.write_string(__temple_w, " | ") or_return /* 60:98 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.cv) or_return /* 60:101 in template */
						__temple_n += __temple_io.write_string(__temple_w, " | ") or_return /* 60:119 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.vs_cpp) or_return /* 60:122 in template */
						__temple_n += __temple_io.write_string(__temple_w, " | ") or_return /* 60:144 in template */
						__temple_n += __temple_io.write_string(__temple_w, row.allocs) or_return /* 60:147 in template */
						__temple_n += __temple_io.write_string(__temple_w, " |") or_return /* 60:169 in template */
					}
				}
				__temple_n += __temple_io.write_string(__temple_w, "\n<!-- END_BENCHMARK_TABLE -->\n") or_return /* 63:11 in template */
				return
